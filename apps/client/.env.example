# API origin for the React client.
# Leave this UNSET for local development: the client calls relative `/api/...` paths
# and Vite proxies them to the Express server on http://localhost:3001 (see vite.config.js).
#
# Set it when the API is hosted somewhere else, e.g.:
# VITE_API_URL=https://api.farmdirect.in/api
