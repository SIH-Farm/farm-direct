{
  "name": "farm-direct",
  "version": "1.0.0",
  "private": true,
  "description": "Digital marketplace connecting Indian farmers directly with consumers",
  "workspaces": [
    "apps/client",
    "apps/server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev --workspace=apps/client",
    "dev:server": "npm run dev --workspace=apps/server",
    "build": "npm run build --workspace=apps/client",
    "start": "npm run start --workspace=apps/server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
